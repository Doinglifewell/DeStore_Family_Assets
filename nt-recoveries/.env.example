# Copy to .env.local for a local run; on Vercel set the same names under
# Project → Settings → Environment Variables. Empty = that part stays off.

# The number every Call button dials: your call-tracking number.
NEXT_PUBLIC_PHONE=

# GA4 web stream Measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA4_ID=

# Google Ads tag ID, e.g. AW-XXXXXXXXXX
NEXT_PUBLIC_ADS_ID=

# Conversion label for taps on a Call button ("Phone call leads: clicks on your number")
NEXT_PUBLIC_ADS_CALL_CLICK_LABEL=

# Conversion label for calls to the number on the site ("Calls to a phone number on your website")
NEXT_PUBLIC_ADS_WEBSITE_CALL_LABEL=
