# Copy to .env.local for a local run; on Vercel set the same names under
# Project → Settings → Environment Variables. A value left empty, or still the
# placeholder (all X's), keeps that part off: nothing loads, nothing is sent.

# The phone number lives in lib/config.ts (CALL_NUMBER). Set this only to
# override it on Vercel without a code change, e.g. 0412 345 678
NEXT_PUBLIC_CALL_NUMBER=

# GA4 web stream Measurement ID
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Ads tag ID
NEXT_PUBLIC_ADS_ID=AW-XXXXXXXXXX

# Ads conversion label fired on every tap of a Call link (the part after the
# slash in AW-XXXXXXXXXX/XXXXXXXXXXX)
NEXT_PUBLIC_ADS_CALL_CLICK_LABEL=XXXXXXXXXXX

# Optional: Google's forwarding number ("Calls to a phone number on your
# website"). Left off while a call-tracking script is set below.
NEXT_PUBLIC_ADS_WEBSITE_CALL_LABEL=

# The call-tracking provider's dynamic number insertion script, https only,
# e.g. https://cdn.example-provider.com/swap.js
NEXT_PUBLIC_DNI_SCRIPT_URL=
